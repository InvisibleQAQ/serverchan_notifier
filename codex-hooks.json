{
  "description": "Send non-blocking ServerChan notifications for Codex completion and approval events.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/serverchan_notifier.py\" --agent codex",
            "commandWindows": "python \"$env:PLUGIN_ROOT\\scripts\\serverchan_notifier.py\" --agent codex",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/serverchan_notifier.py\" --agent codex",
            "commandWindows": "python \"$env:PLUGIN_ROOT\\scripts\\serverchan_notifier.py\" --agent codex",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/serverchan_notifier.py\" --agent codex",
            "commandWindows": "python \"$env:PLUGIN_ROOT\\scripts\\serverchan_notifier.py\" --agent codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
