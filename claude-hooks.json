{
  "description": "Send non-blocking ServerChan notifications for Claude Code lifecycle events.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/serverchan_notifier.py\" --agent claude",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/serverchan_notifier.py\" --agent claude",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/serverchan_notifier.py\" --agent claude",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "^idle_prompt$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/serverchan_notifier.py\" --agent claude",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "^(logout|prompt_input_exit|other)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/serverchan_notifier.py\" --agent claude",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
